[project]
name = "PROJECT_SLUG_PLACEHOLDER"
version = "0.1.0"
description = "Production-grade FastAPI AI/ML service."
requires-python = ">=3.11"
dependencies = [
  "fastapi>=0.115",
  "uvicorn[standard]>=0.30",
  "pydantic[email]>=2.7",
  "pydantic-settings>=2.3",
  "sqlmodel>=0.0.21",
  "alembic>=1.13",
  "bcrypt>=4.1",
  "pyjwt>=2.8",
  "httpx>=0.27",
  "python-multipart>=0.0.9",
  "gunicorn>=22.0",
]

[project.optional-dependencies]
dev = [
  "pytest>=8.0",
  "anyio>=4.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["app"]
