"""Application settings, loaded once from the environment.

`get_settings()` is cached so the same Settings instance is reused process-wide
instead of re-reading the environment on every dependency resolution.
"""
from __future__ import annotations

from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    app_name: str = "PROJECT_SLUG_PLACEHOLDER"
    environment: str = "development"

    database_url: str = "sqlite:///./dev.db"

    jwt_secret: str = "change-me"
    jwt_algorithm: str = "HS256"
    access_token_expire_minutes: int = 30

    model_path: str = "models/model.bin"
    model_version: str = "model-0.1.0"

    llm_base_url: str = ""
    llm_api_key: str = ""

    max_input_chars: int = 4000
    max_output_tokens: int = 512


@lru_cache
def get_settings() -> Settings:
    return Settings()
