"""Startup/shutdown wiring.

Per-process singletons are created once here and stored on app.state, then
injected via dependencies (see app/api/deps.py): the ML model, a shared
httpx.AsyncClient (connection pooling), and the database engine. Constructing
any of these per request defeats pooling and, for the model, OOMs under load.
"""
from __future__ import annotations

import logging
from contextlib import asynccontextmanager

import httpx
from fastapi import FastAPI

from app.config import get_settings
from app.db.session import create_db_engine, init_db
from app.ml.model import load_model

logger = logging.getLogger(__name__)


@asynccontextmanager
async def lifespan(app: FastAPI):
    settings = get_settings()

    app.state.db_engine = create_db_engine(settings.database_url)
    # Dev convenience only; production schema changes go through Alembic.
    if settings.environment == "development":
        init_db(app.state.db_engine)

    app.state.model = load_model(settings.model_path)
    app.state.model_version = settings.model_version

    app.state.http = httpx.AsyncClient(
        base_url=settings.llm_base_url or "http://localhost",
        timeout=httpx.Timeout(connect=2.0, read=30.0, write=10.0, pool=2.0),
        limits=httpx.Limits(max_connections=100, max_keepalive_connections=20),
    )
    logger.info("startup complete", extra={"extra": {"model_version": settings.model_version}})

    yield

    await app.state.http.aclose()
    app.state.model = None
    app.state.db_engine.dispose()
    logger.info("shutdown complete")
