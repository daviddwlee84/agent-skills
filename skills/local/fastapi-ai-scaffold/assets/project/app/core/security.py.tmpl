"""Password hashing (bcrypt) and JWT encode/decode with a pinned algorithm.

Never use a fast hash (SHA-256) for passwords. Always verify JWTs with an
explicit algorithm allowlist — trusting the token's own `alg` header enables the
alg=none and key-confusion forgeries.
"""
from __future__ import annotations

import base64
import hashlib
from datetime import datetime, timedelta, timezone

import bcrypt
import jwt

from app.config import Settings


def _normalize(password: str) -> bytes:
    # bcrypt only uses the first 72 bytes (and modern versions reject longer
    # input). Pre-hash so the full password contributes and length is bounded.
    digest = hashlib.sha256(password.encode("utf-8")).digest()
    return base64.b64encode(digest)


def hash_password(plain: str) -> str:
    return bcrypt.hashpw(_normalize(plain), bcrypt.gensalt()).decode("utf-8")


def verify_password(plain: str, hashed: str) -> bool:
    return bcrypt.checkpw(_normalize(plain), hashed.encode("utf-8"))


def create_access_token(subject: str, settings: Settings) -> str:
    now = datetime.now(timezone.utc)
    payload = {
        "sub": subject,
        "iat": now,
        "exp": now + timedelta(minutes=settings.access_token_expire_minutes),
    }
    return jwt.encode(payload, settings.jwt_secret, algorithm=settings.jwt_algorithm)


def decode_access_token(token: str, settings: Settings) -> dict:
    # algorithms is an allowlist — this is the pin that prevents alg=none.
    return jwt.decode(token, settings.jwt_secret, algorithms=[settings.jwt_algorithm])
