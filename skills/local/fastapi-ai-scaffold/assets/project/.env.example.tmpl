# Copy to .env and fill in real values. Never commit .env.
APP_NAME=PROJECT_SLUG_PLACEHOLDER
ENVIRONMENT=development

# Database. SQLite for local dev; a Postgres URL in production, e.g.
# postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# JWT signing. Generate a strong random secret, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Model artifact path (loaded once at startup).
MODEL_PATH=models/model.bin
MODEL_VERSION=model-0.1.0

# Upstream LLM gateway (optional). Leave blank to use the built-in stub.
LLM_BASE_URL=
LLM_API_KEY=

# Caps (cost + abuse control).
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=512
