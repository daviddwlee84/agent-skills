[project]
name = "{{REPO_NAME}}-docs"
version = "0.0.0"
description = "Docs build environment for {{SITE_NAME}}"
requires-python = ">=3.11"

[project.optional-dependencies]
docs = [
    "mkdocs>=1.6",
    "mkdocs-material>=9.5",
    "mkdocs-llmstxt>=0.2",
    "mkdocs-copy-to-llm>=0.1",
    "pymdown-extensions>=10.7",
]
