# MLflow stack — environment configuration template.
# Copy to .env and customize. .env is gitignored; .env.example is committed.

# ---- MLflow ----
# Note: macOS uses port 5000 for AirPlay; default to 8000.
MLFLOW_PORT=8000
MLFLOW_BUCKET_NAME=mlflow

# ---- PostgreSQL (tracking + registry backend) ----
PG_USER=mlflow
PG_PASSWORD=mlflow            # ← CHANGE FOR ANY NON-LOCAL USE
PG_DATABASE=mlflow
PG_PORT=5432

# ---- MinIO (S3-compatible artifact storage) ----
MINIO_ACCESS_KEY=minioadmin           # ← CHANGE FOR ANY NON-LOCAL USE
MINIO_SECRET_ACCESS_KEY=minioadmin    # ← CHANGE FOR ANY NON-LOCAL USE
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
