# first written. See references/homebrew-tap.md.
class Mytool < Formula
  desc "SHORT DESCRIPTION"
  homepage "https://github.com/OWNER/mytool"
  version "__VERSION__"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/OWNER/mytool/releases/download/v__VERSION__/mytool___VERSION___darwin_arm64.tar.gz"
      sha256 "__SHA256_DARWIN_ARM64__"
    end
    on_intel do
      url "https://github.com/OWNER/mytool/releases/download/v__VERSION__/mytool___VERSION___darwin_amd64.tar.gz"
      sha256 "__SHA256_DARWIN_AMD64__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/OWNER/mytool/releases/download/v__VERSION__/mytool___VERSION___linux_arm64.tar.gz"
      sha256 "__SHA256_LINUX_ARM64__"
    end
    on_intel do
      url "https://github.com/OWNER/mytool/releases/download/v__VERSION__/mytool___VERSION___linux_amd64.tar.gz"
      sha256 "__SHA256_LINUX_AMD64__"
    end
  end

  head do
    url "https://github.com/OWNER/mytool.git", branch: "main"
    depends_on "go" => :build
  end

  def install
    if build.head?
      system "go", "build", *std_go_args(ldflags: "-s -w")
